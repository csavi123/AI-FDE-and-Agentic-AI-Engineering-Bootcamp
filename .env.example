# Paste your Anthropic API key after the = sign (no quotes, no spaces).
ANTHROPIC_API_KEY=
# Secret password callers must send in the X-App-Token header.
APP_TOKEN=
# Where the Streamlit UI sends questions (your local or Render URL).
API_URL=http://127.0.0.1:8000
# Testing switch: "true" allows force_bad and shows the UI toggle. Keep false in production.
ALLOW_FORCE_BAD=false
# Pinecone API key (Pinecone console > API Keys). Used for both embeddings and storage.
PINECONE_API_KEY=
# Name of your Pinecone index. Create it with dimension 1024 and metric cosine (llama-text-embed-v2).
PINECONE_INDEX_NAME=
# Optional: chunk size and overlap for /ingest, in characters (defaults 800 and 100).
CHUNK_SIZE=800
CHUNK_OVERLAP=100
